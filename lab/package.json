{
  "name": "ccarf-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "l1": "tsx --env-file-if-exists=.env 01-agentic-loop/loop.ts",
    "l1:solution": "tsx --env-file-if-exists=.env 01-agentic-loop/solution/loop.ts",
    "l2:check": "tsx 02-mcp-tools/check.ts server.ts",
    "l2:check:solution": "tsx 02-mcp-tools/check.ts solution/server.ts",
    "l2:ask": "tsx 02-mcp-tools/ask.ts",
    "l3:check": "tsx 03-hooks/check.ts",
    "l3:check:solution": "tsx 03-hooks/check.ts solution",
    "l3:ask": "tsx 03-hooks/agent.ts",
    "l4:check": "tsx 04-subagents/check.ts",
    "l4:check:solution": "tsx 04-subagents/check.ts solution",
    "l4:ask": "tsx 04-subagents/run.ts",
    "l5:check": "tsx 05-provenance/check.ts",
    "l5:check:solution": "tsx 05-provenance/check.ts solution",
    "l5:ask": "tsx 05-provenance/run.ts",
    "l6:check": "tsx 06-sessions/check.ts",
    "l6:check:solution": "tsx 06-sessions/check.ts solution",
    "l6:ask": "tsx 06-sessions/run.ts",
    "quiz": "tsx quiz/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
